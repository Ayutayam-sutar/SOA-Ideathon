[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/newprogrammer07/SOA-Ideathon
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[remote "upstream"]
	url = https://github.com/Juggernauts-jod/SOA-Ideathon
	fetch = +refs/heads/*:refs/remotes/upstream/*
[branch "backend"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/backend
[branch "update100"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/update100
